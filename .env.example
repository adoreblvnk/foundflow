# FoundFlow Environment Configuration

# Next.js Server Port (optional)
PORT=3000

# Secure cookie signing secret (Provide a secure cryptographically random string of at least 32 characters)
AUTH_SECRET=

# Required username for prototype login
LOGIN_USERNAME=

# Required password for prototype login
LOGIN_PASSWORD=

# Temporary synthetic demo mode. Bypasses login, hides non-demo records, and marks new records as demo data.
AUTH_DISABLED=false
# Real provider scans are blocked while login is disabled unless explicitly enabled.
DEMO_AI_SCAN_ENABLED=false

# Application-layer encryption. Production defaults to required.
# The first key is active; append previous keys after it during rotation.
DATA_PROTECTION_MODE=required
DATA_ENCRYPTION_KEYS=2026q3:<base64-encoded-32-byte-key>
# Enable only during a controlled migration from legacy field-only encryption scopes.
DATA_PROTECTION_ALLOW_LEGACY_SCOPE=false

# OpenAI API key, fast extraction model, and strong verifier for currency/complex photos
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_VERIFIER_MODEL=gpt-5.6-sol

# Provider-assisted search is opt-in. Local keyword search remains available when false.
AI_SEARCH_ENABLED=false
OPENAI_SEARCH_MODEL=gpt-4o-mini

# Agnes AI (optional alternative vision provider — OpenAI-compatible, sponsor)
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# Local development defaults to a local libSQL file and private uploads.
DATA_DIR=./data

# Hosted storage. Vercel injects these when Turso and Blob are connected.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
