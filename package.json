{
  "name": "foundflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "DATA_DIR=./data-test node --experimental-strip-types tests/domain.test.ts",
    "test:ai": "node --env-file=.env --experimental-strip-types tests/smoke-test-ai.ts",
    "test:ai:codex": "node --experimental-strip-types tests/smoke-test-codex.ts",
    "test:e2e:playwright": "npm run build && playwright test --config=playwright.config.mjs",
    "test:e2e": "node tests/e2e-browser.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.6.1",
    "ai": "^6.0.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "undici": "6.28.0",
    "next": {
      "postcss": "8.5.21"
    },
    "sharp": "0.35.3"
  }
}
